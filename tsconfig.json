{
  "compilerOptions": {
    "typeRoots": ["node_modules/@types", "node_modules"],
    "types": ["chai", "mocha"],
    "target": "es2021",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "module": "CommonJS",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // "strict": true,
    "skipLibCheck": true,
    "strictPropertyInitialization": false,
    "allowSyntheticDefaultImports": true,
    "baseUrl": "./src",
    "paths": {
      "@domain/": ["./domain/"],
      "@domain/*": ["./domain/*"],
      "@core/": ["./core/"],
      "@core/*": ["./core/*"],
      "@data/": ["./data/"],
      "@data/*": ["./data/*"],
      "@api/": ["./api/"],
      "@api/*": ["./api/*"],
      "@test/": ["./test/"],
      "@test/*": ["./test/*"],
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "*.test.ts",
  ]
}
