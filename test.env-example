DATABASE_URL=postgresql://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DB_USER=username          # nome de usuario do banco de dados de testes
DB_PASS=password          # senha do banco de dados de testes
DB_HOST=localhost         # host do banco de dados de testes
DB_PORT=5432              # porta do banco de dados de testes
DB_NAME=database_name     # nome do banco de dados de testes
SECRET_KEY=base64_32      # chave secreta de criptografia
