{
  "name": "dijkstra",
  "version": "1.0.0",
  "description": "The project is named **Dijkstra**, in tribute to Edsger Wybe Dijkstra, a renowned computer scientist, programmer, software engineer, and mathematician. Dijkstra was a Turing Award winner and made significant contributions to computing, including the creation of the famous Dijkstra's algorithm.",
  "main": "index.js",
  "save-exact": true,
  "type": "commonjs",
  "scripts": {
    "start": "ts-node -r tsconfig-paths/register ./src/api/server.ts",
    "dev": "nodemon -r tsconfig-paths/register src/api/server.ts",
    "test": "NODE_ENV=test mocha --require ts-node/register --require tsconfig-paths/register 'src/test/**/*.ts'",
    "lint": "eslint . ",
    "seed": "ts-node -r tsconfig-paths/register src/data/database/seed.ts"
  },
  "prisma": {
    "schema": "src/data/database/schema.prisma"
  },
